{
  "$schema": "https://opencode.ai/config.json",

  // =========================================================================
  // Default model
  // =========================================================================

  "model": "opencode/gpt-5.2-codex-medium",

  // =========================================================================
  // Providers injected by opencode-openai-codex-auth
  // =========================================================================

  "provider": {
    "opencode": {
      "models": {
        // ===============================================================
        // GPT-5.2
        // ===============================================================

        "gpt-5.2": {
          "variants": {
            "none": {
              "reasoningEffort": "minimal"
            },

            "low": {
              "reasoningEffort": "low"
            },

            "medium": {
              "reasoningEffort": "medium"
            },

            "high": {
              "reasoningEffort": "high"
            },

            "xhigh": {
              "reasoningEffort": "high",
              "textVerbosity": "high"
            }
          }
        },

        // ===============================================================
        // GPT-5.2 Codex
        // ===============================================================

        "gpt-5.2-codex": {
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },

            "medium": {
              "reasoningEffort": "medium"
            },

            "high": {
              "reasoningEffort": "high"
            },

            "xhigh": {
              "reasoningEffort": "high",
              "textVerbosity": "high"
            }
          }
        }
      }
    }
  },

  // =========================================================================
  // Useful aliases
  // =========================================================================

  "alias": {
    "fast": "opencode/gpt-5.2-codex-low",
    "balanced": "opencode/gpt-5.2-codex-medium",
    "deep": "opencode/gpt-5.2-codex-high",
    "max": "opencode/gpt-5.2-codex-xhigh"
  },

  // =========================================================================
  // Tool permissions
  // =========================================================================

  "permissions": {
    "bash": "ask",
    "edit": "allow",
    "webfetch": "allow"
  },

  // =========================================================================
  // UI / UX
  // =========================================================================

  "theme": "system",

  "autoupdate": true,

  "telemetry": false,

  // =========================================================================
  // Optional shell environment inheritance
  // =========================================================================

  "shell": {
    "inheritEnv": true
  },

  // =========================================================================
  // Optional agent behavior tuning
  // =========================================================================

  "agent": {
    "compactThreshold": 12000,
    "summarizeThreshold": 24000
  }
}
